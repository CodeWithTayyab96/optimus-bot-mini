# ────────────────────────────────────────────────────────────
#  .env.mini.example — Optimus Mini environment template.
#
#    [ -f .env ] || cp .env.mini.example .env    # never clobber an existing .env
#    chmod 600 .env            # keep it private — it holds your secrets
#    nano .env                 # fill in the values you need
#
#  ⚠️  This project may already ship a .env with real credentials. Check first
#      and back it up — see the note near the bottom of this file.
#
#  Every value is OPTIONAL. The bot starts and connects with none of them set;
#  the commands that need a key simply say so when used. Never commit .env.
#
#  Mini is deliberately smaller than the full edition's .env: it has no
#  YouTube/download stack, so none of the yt-dlp / WARP / PO-token variables
#  apply. See .env.example for those (full edition only).
# ────────────────────────────────────────────────────────────

# ── Runtime tuning (safe defaults; uncomment to override) ────
# Restart the process when RSS passes this, in MB. Keep it BELOW the systemd
# MemoryMax / pm2 max_memory_restart so the bot restarts itself cleanly first.
# Measured peak is ~119 MB, so 180 leaves ~50% headroom while leaving ~400 MB of
# a 580 MB host to the OS. Default: 180
# MAX_RSS_MB=180

# Rotating log file. Set to "off" when systemd/journald or pm2 owns the logs.
# Default: logs/mini.log
# MINI_LOG_FILE=logs/mini.log
# Per-file size cap before rotation (bytes). Default: 2097152 (2 MB)
# MINI_LOG_MAX_BYTES=2097152
# Rotated generations kept. Total ceiling ≈ MAX_BYTES × (KEEP + 1). Default: 2
# MINI_LOG_KEEP=2
# Per-second write cap — drops excess lines during an error storm. Default: 262144
# MINI_LOG_MAX_BYTES_PER_SEC=262144

# Temporary-file policy. Default: 1 hour max age, 64 MB total.
# MINI_TMP_MAX_AGE_MS=3600000
# MINI_TMP_MAX_BYTES=67108864

# Reconnect backoff for the WhatsApp socket. Default: 2 s → 60 s, doubling.
# MINI_RECONNECT_BASE_MS=2000
# MINI_RECONNECT_MAX_MS=60000

# Crash-loop backoff. A start shorter than FASTFAIL counts as a failed start,
# and the next attempt waits BASE × 2^n (capped at MAX). Defaults: 30 s / 2 s / 5 min
# MINI_BOOT_FASTFAIL_MS=30000
# MINI_BOOT_BACKOFF_BASE_MS=2000
# MINI_BOOT_BACKOFF_MAX_MS=300000

# ── IMPORTANT: an .env file may already exist in this project ──
# It ships with real credentials and WARP=1. `cp .env.mini.example .env` would
# overwrite it. Back it up first:
#     ls -l .env && cp -n .env .env.backup-$(date +%F)
# Mini ignores WARP (the tunnel is not started); only the full edition acts on it.

# ── Optional feature groups (off by default) ─────────────────
# Comma-separated. Enabling a group may need extra packages installed with a
# plain `npm install` (NOT --omit=optional). See OPTIMUS_MINI_DEPLOY.md §6.
#   ai        text AI commands (no extra packages)
#   anime     anime search/image (no extra packages)
#   media     downloads (needs yt-search, ruhend-scraper, ffmpeg)
#   stickers  sticker maker (needs ffmpeg-static, fluent-ffmpeg, node-webpmux)
#   image     image editing + PDF study (needs sharp, jimp, mammoth, pdf-parse)
#   textmaker styled text (needs mumaker)
#   extras    news/translate/github/url/tts (needs cheerio, google-translate-api-x, moment-timezone, gtts)
# MINI_ENABLE=ai

# ── Owner / identity ────────────────────────────────────────
# These live in settings.js (committed, placeholders only). Override here if you
# prefer not to edit that file. Numbers: country code + number, no + or spaces.
# The BOT number is the account the bot runs on; the OWNER number commands it.
# BOT_NUMBER=923001234567
# OWNER_NUMBER=923001234567

# ── AI providers (only if you enable MINI_ENABLE=ai) ─────────
GROQ_API_KEY=            # console.groq.com
GEMINI_API_KEY=          # aistudio.google.com

# ── Command-specific keys (all optional) ─────────────────────
GIPHY_API_KEY=           # .gif — developers.giphy.com
OMDB_API_KEY=            # .imdb — omdbapi.com/apikey.aspx
TENOR_API_KEY=           # .emojimix — console.cloud.google.com (Tenor API)
TELEGRAM_BOT_TOKEN=      # .stickertelegram — create with @BotFather
TMDB_API_KEY=            # .tmdb — themoviedb.org/settings/api

# .dictionary / .define and .ddg need NO key (free, keyless APIs).
